    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "gtfs-realtime-bindings": "^1.1.1",
    "maplibre-gl": "^5.6.0",
    "three": "^0.170.0"
  }
}
